{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timberspecialist",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "TimberPhpContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PHP_BACKEND",
        "class_name": "TimberPhpContainer"
      }
    ]
  },
  "exports": {
    "TimberPhpContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "timber-specialist-orders",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["contact@timberspecialist.ro"],
      "allowed_sender_addresses": ["comenzi@timberspecialist.ro"]
    }
  ],
  "vars": {
    "MAIL_TO": "contact@timberspecialist.ro",
    "MAIL_FROM": "comenzi@timberspecialist.ro"
  },
  "observability": {
    "enabled": true
  }
}
