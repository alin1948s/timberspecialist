FROM php:8.3-apache

RUN a2enmod headers rewrite

ENV TIMBER_BACKEND_MODE=cloudflare

COPY admin-auth.php /var/www/html/admin-auth.php
COPY admin-session.php /var/www/html/admin-session.php
COPY orders_api.php /var/www/html/orders_api.php
COPY sendmail.php /var/www/html/sendmail.php
COPY cloudflare/php/runtime.php /var/www/html/cloudflare-runtime.php
COPY cloudflare/php/health.php /var/www/html/health.php
COPY cloudflare/php/apache-site.conf /etc/apache2/sites-available/000-default.conf

EXPOSE 80
